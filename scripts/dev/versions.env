# Pinned versions for the development containers.
#
# Keep this file in sync with scripts/dev/*.sh. Bumping a value here and
# rebuilding the image is how these tools get updated, mirroring the
# SHA-pinned nvim plugins used by the base OS image.

BUN_VERSION=1.4.2
TYPESCRIPT_VERSION=7.0.2
TAILWIND_VERSION=4.3.3
PNPM_VERSION=12.10.1
OPENCODE_VERSION=1.18.35
PI_VERSION=1.1.0
RUST_TOOLCHAIN=stable
