[Unit]
Description=Paddlefish OS first boot user setup
ConditionPathExists=!/var/lib/paddlefish/firstboot.done
After=systemd-remount-fs.service systemd-vconsole-setup.service
Before=getty.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/paddlefish/firstboot-setup.sh
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes

[Install]
WantedBy=multi-user.target
