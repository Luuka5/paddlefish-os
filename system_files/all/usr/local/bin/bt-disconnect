#!/bin/sh
set -euo pipefail

# Stateless: disconnect the first paired device that is connected.
for mac in $(bluetoothctl devices Paired | awk '{print $2}'); do
    state=$(bluetoothctl info "$mac" 2>/dev/null | sed -n 's/^[[:space:]]*Connected: //p')
    if [ "$state" = "yes" ]; then
        bluetoothctl disconnect "$mac"
        exit 0
    fi
done

exit 1
