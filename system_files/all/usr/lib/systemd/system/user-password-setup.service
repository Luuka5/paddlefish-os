[Unit]
Description=Force password change for the baked default user on first real boot
# Runs only on the first boot of a freshly installed system, never in the live ISO.
ConditionFirstBoot=yes
ConditionKernelCommandLine=!rd.live
Before=systemd-user-sessions.service

[Service]
Type=oneshot
ExecStart=/usr/bin/chage -d 0 user
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
