{
    "layer": "top",
    "position": "top",
    "spacing": 2,
    "modules-left": [
        "niri/workspaces",
        "niri/scratchpad",
        "niri/window"
    ],
    "modules-center": [
        "power-profiles-daemon",
        "cpu",
        "memory",
        "temperature",
        "battery"
    ],
    "modules-right": [
        "idle_inhibitor",
        "pulseaudio",
        "backlight",
        //"niri/language",
        "clock",
        "tray"
    ],
    "niri/workspaces": {
        "format": "{index}"
    },
    "niri/window": {
        "format": "{title}",
        "max-length": 40
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "◉",
            "deactivated": ""
        }
    },
    "tray": {
        "spacing": 4
    },
    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "cpu": {
        "format": "{usage}% ",
        "tooltip": false
    },
    "memory": {
        "format": "{}% "
    },
    "temperature": {
        "critical-threshold": 80,
        "format": "{temperatureC}°C "
    },
    "backlight": {
        "format": "{percent}% 󰖨"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% 󰁹",
        "format-full": "{capacity}% 󰁹",
        "format-charging": "{capacity}% 󰁹",
        "format-plugged": "{capacity}% 󰁹",
        "format-alt": "{time}",
        "format-icons": ["▁", "▂", "▃", "▅", "▇"]
    },
    "battery#bat2": {
        "bat": "BAT2"
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}",
        "tooltip": true,
        "format-icons": {
            "default": "󱐋",
            "performance": "󱐋",
            "balanced": "",
            "power-saver": "󰌪"
        }
    },
    "pulseaudio": {
        "format": "{volume}% ",
        "format-muted": "muted",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "on-click": "pavucontrol"
    },
    "niri/language": {
        "format": "{short}"
    }
}
