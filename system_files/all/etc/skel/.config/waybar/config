{
    "layer": "top",
    "position": "top",
    // "height": 18,
    "spacing": 2,
    "modules-left": [
        "niri/workspaces",
        "niri/scratchpad"
    ],
    "modules-center": [
        "niri/window"
    ],
    "modules-right": [
        "idle_inhibitor",
        "pulseaudio",
        "network",
        "power-profiles-daemon",
        "cpu",
        "memory",
        "temperature",
        "backlight",
        "niri/language",
        "battery",
        "clock",
        "tray",
        "custom/power"
    ],
    "niri/workspaces": {
        "format": "{index}"
    },
    "niri/scratchpad": {
        "format": "{icon} {count}",
        "show-empty": false,
        "format-icons": ["", "U"],
        "tooltip": true,
        "tooltip-format": "{app}: {title}"
    },
    "niri/window": {
        "format": "{title}",
        "max-length": 40
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "◉",
            "deactivated": "◌"
        }
    },
    "tray": {
        "spacing": 4
    },
    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%a %d %b}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "cpu": {
        "format": "{usage}%",
        "tooltip": false
    },
    "memory": {
        "format": "{}%"
    },
    "temperature": {
        "critical-threshold": 80,
        "format": "{temperatureC}°C"
    },
    "backlight": {
        "format": "{percent}%"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}%",
        "format-full": "{capacity}%",
        "format-charging": "{capacity}%",
        "format-plugged": "{capacity}%",
        "format-alt": "{time}",
        "format-icons": ["▁", "▂", "▃", "▅", "▇"]
    },
    "battery#bat2": {
        "bat": "BAT2"
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
        "tooltip": true,
        "format-icons": {
            "default": "⚡",
            "performance": "⚡",
            "balanced": "◐",
            "power-saver": "◔"
        }
    },
    "network": {
        "format-wifi": "{essid} {signalStrength}%",
        "format-ethernet": "{ipaddr}",
        "format-linked": "{ifname}",
        "format-disconnected": "⚠",
        "tooltip-format": "{ifname} via {gwaddr}"
    },
    "pulseaudio": {
        "format": "{volume}%",
        "format-muted": "muted",
        "format-source": "{volume}%",
        "format-source-muted": "",
        "on-click": "pavucontrol"
    },
    "niri/language": {
        "format": "{short}"
    },
    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "$HOME/.config/waybar/power_menu.xml",
        "menu-actions": {
            "shutdown": "systemctl poweroff",
            "reboot": "systemctl reboot",
            "suspend": "systemctl suspend",
            "hibernate": "systemctl hibernate"
        }
    }
}
