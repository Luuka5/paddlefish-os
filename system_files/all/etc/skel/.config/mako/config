[global]
font=FiraCode Nerd Font Mono:size=12
width=300
height=150
margin=8
padding=8
border-size=2
border-color=#2c78bf
background-color=#1c1b19
text-color=#fce8c3
progress-color=#519f50
text-alignment=left
icons=1
max-icon-size=64

[urgency=low]
border-color=#2c78bf
background-color=#1c1b19
text-color=#fce8c3
default-timeout=5000

[urgency=normal]
border-color=#2c78bf
background-color=#1c1b19
text-color=#fce8c3
default-timeout=5000

[urgency=critical]
border-color=#ef2f27
background-color=#1c1b19
text-color=#fce8c3
default-timeout=0